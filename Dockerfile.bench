# Sandbox for building the benchmark: the code-domain grader EXECUTES model-written Python,
# so run it here rather than on your own machine.
#   docker build -f Dockerfile.bench -t router-bench .
#   docker run --rm -e GROQ_API_KEY=... -v "$PWD/data:/app/data" router-bench python -m scripts.build_benchmark
FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
RUN useradd -m runner && chown -R runner /app
USER runner
